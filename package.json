{
  "name": "@aartoni/strapi-plugin-oidc",
  "version": "1.2.0",
  "description": "Replace the Strapi 5 admin login with your OIDC provider",
  "strapi": {
    "displayName": "Single Sign On",
    "name": "oidc",
    "description": "Single Sign-On via OpenID Connect",
    "kind": "plugin"
  },
  "scripts": {
    "build": "strapi-plugin build",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link",
    "verify": "strapi-plugin verify",
    "lint": "NODE_OPTIONS=--experimental-strip-types eslint --flag unstable_native_nodejs_ts_config",
    "test:jest": "ENV_PATH=./playground/.env  jest --verbose --runInBand --forceExit --detectOpenHandles",
    "test:cypress": "NODE_EXTRA_CA_CERTS=data/common/certs/cacert.pem cypress run",
    "e2e:services:up": "sh scripts/isscert.dev.sh && docker compose up --build --wait --force-recreate",
    "e2e:services:down": "docker compose down -v --remove-orphans",
    "test:cypress:open": "cypress open",
    "playground:install": "yalc push && yarn playground:yalc-add-link && cd playground && yarn install --frozen-lockfile",
    "playground:yalc-add": "cd playground && yalc add @aartoni/strapi-plugin-oidc",
    "playground:yalc-add-link": "cd playground && yalc add --link @aartoni/strapi-plugin-oidc",
    "playground:build": "cd playground && yarn build",
    "playground:develop": "cd playground && yarn develop",
    "playground:start": "cd playground && yarn start"
  },
  "keywords": [
    "strapi",
    "plugin",
    "oauth",
    "SSO",
    "OIDC",
    "OpenID Connect"
  ],
  "peerDependencies": {
    "@strapi/design-system": "^2.2.3",
    "@strapi/icons": "^2.2.3",
    "@strapi/strapi": "^5.50.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-intl": "^6.6.0",
    "react-router-dom": "^6.30.3",
    "styled-components": "^6.4.0",
    "vite": "^5.4.21"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "@jmespath-community/jmespath": "^1.3.0",
    "jose": "^6.2.3"
  },
  "author": {
    "name": "aartoni",
    "url": "https://github.com/aartoni"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aartoni/strapi-plugin-oidc.git"
  },
  "bugs": {
    "url": "https://github.com/aartoni/strapi-plugin-oidc/issues"
  },
  "maintainers": [
    {
      "name": "aartoni"
    }
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0 <25.0.0",
    "npm": ">=8.6.0"
  },
  "files": [
    "dist",
    "admin/src/OidcLoginPage.tsx"
  ],
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-typescript": "^7.29.0",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.4.1",
    "@strapi/admin": "^5.50.1",
    "@strapi/design-system": "^2.2.3",
    "@strapi/icons": "^2.2.3",
    "@strapi/sdk-plugin": "^6.1.1",
    "@strapi/strapi": "^5.50.1",
    "@strapi/typescript-utils": "^5.50.1",
    "@testing-library/cypress": "^10.1.0",
    "@types/cookies": "^0.9.2",
    "@types/koa": "^2.15.2",
    "@types/node": "^26.1.1",
    "@types/react": "^18.0.0",
    "@types/supertest": "^7.2.1",
    "accepts": "^1.3.8",
    "cypress": "^15.18.0",
    "cypress-terminal-report": "^7.3.0",
    "dotenv": "^17.4.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^6.4.1",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
    "jest": "^30.4.0",
    "nock": "^14.0.5",
    "prettier": "^3.9.4",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-intl": "^6.6.0",
    "react-router-dom": "^6.30.3",
    "styled-components": "^6.4.0",
    "supertest": "^7.2.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.62.0",
    "vite": "5.4.21",
    "yalc": "^1.0.0-pre.53"
  },
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "source": "./vite/index.ts",
      "require": "./dist/vite/index.js",
      "default": "./dist/vite/index.js"
    },
    "./strapi-server": {
      "types": "./dist/server/index.d.ts",
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  }
}
